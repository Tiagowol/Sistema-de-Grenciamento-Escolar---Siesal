datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id_usuario        Int       @id @default(autoincrement())
  nome              String    @db.VarChar(100)
  email             String    @unique @db.VarChar(100)
  senha             String    @db.VarChar(255)
  data_cadastro     DateTime  @default(now())
  status            Boolean   @default(true)
  tentativas_falhas Int       @default(0)
  bloqueado_ate     DateTime?

  marcadores   Marcador[]
  tarefas      Tarefa[]
  eventos      Evento[]
  lembretes    Lembrete[]
  notificacoes Notificacao[]

  @@map("usuario")
}

model Marcador {
  id_marcador Int    @id @default(autoincrement())
  nome        String @db.VarChar(50)
  cor         String @db.VarChar(20)
  id_usuario  Int

  usuario Usuario  @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
  tarefas Tarefa[]

  @@map("marcador")
}

model Tarefa {
  id_tarefa    Int      @id @default(autoincrement())
  titulo       String   @db.VarChar(100)
  descricao    String?  @db.Text
  data_criacao DateTime @default(now())
  data_entrega DateTime
  prioridade   String   @db.VarChar(20) // "Urgente", "Proximo", "Longe", "Alta", "Média", "Baixa"
  status       String   @default("Pendente") @db.VarChar(20) // "Pendente", "Concluido", "No prazo", "Atrasado"
  dificuldade  String?  @db.VarChar(20) // "Fácil", "Médio", "Difícil"
  tipo         String?  @db.VarChar(50) // "Atividade", "Trabalho", "Prova", "Exercício"
  professor    String?  @db.VarChar(100)
  id_usuario   Int
  id_marcador  Int?

  usuario   Usuario    @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
  marcador  Marcador?  @relation(fields: [id_marcador], references: [id_marcador], onDelete: SetNull)
  lembretes Lembrete[]

  @@map("tarefa")
}

model Evento {
  id_evento   Int      @id @default(autoincrement())
  titulo      String   @db.VarChar(100)
  descricao   String?  @db.Text
  data_inicio DateTime
  data_fim    DateTime
  local       String?  @db.VarChar(100)
  id_usuario  Int

  usuario   Usuario    @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
  lembretes Lembrete[]

  @@map("evento")
}

model Lembrete {
  id_lembrete Int       @id @default(autoincrement())
  mensagem    String    @db.VarChar(255)
  data_hora   DateTime
  data_envio  DateTime?
  enviado     Boolean   @default(false)
  id_usuario  Int
  id_tarefa   Int?
  id_evento   Int?

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
  tarefa  Tarefa? @relation(fields: [id_tarefa], references: [id_tarefa], onDelete: Cascade)
  evento  Evento? @relation(fields: [id_evento], references: [id_evento], onDelete: Cascade)

  @@map("lembrete")
}

model Notificacao {
  id_notificacao Int      @id @default(autoincrement())
  titulo         String   @db.VarChar(100)
  mensagem       String   @db.Text
  data_envio     DateTime @default(now())
  lida           Boolean  @default(false)
  id_usuario     Int

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@map("notificacao")
}
