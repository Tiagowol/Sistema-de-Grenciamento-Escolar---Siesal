# SIESAL 4.0 — modelo de variáveis de ambiente.
# Copie para .env e preencha. NÃO coloque valores reais neste arquivo.
# Segredos: gerar com `openssl rand -base64 32`. Nunca reutilizar valores da v3.

NODE_ENV=development

# Porta da API, publicada só em 127.0.0.1 (D11)
API_PORTA=3000

# Banco (PostgreSQL 18.6). Sem porta publicada no host.
POSTGRES_DB=siesal
POSTGRES_USER=
POSTGRES_PASSWORD=

# Senha do papel siesal_app (ADR-002). Gerar com `openssl rand -hex 24` (só letras e números, vai dentro de URL).
# O papel siesal_owner não faz login e não tem senha.
SIESAL_APP_PASSWORD=

# Nomes de usuário dos 2 Masters (3 a 32 letras minúsculas, números ou _). Usados só pelo job bootstrap.
MASTER_1_USUARIO=
MASTER_2_USUARIO=

# Trava do job migrate: só use "sim" depois de fazer o backup (scripts/backup.sh)
CONFIRMA_BACKUP=nao

# Segredo da autenticação própria (Lote 5, ADR-008): cifra o segredo do TOTP. Mínimo 32 caracteres.
# Gerar com `openssl rand -base64 48`. Trocar o valor invalida os TOTP já cadastrados.
AUTH_SECRET=

# --- Acesso pelo navegador (Lote 6) ---
# Porta do site (nginx). Abrir em http://localhost:8080
WEB_PORTA=8080
# 127.0.0.1 = só este computador. 0.0.0.0 = outros aparelhos da rede (http://IP-DO-COMPUTADOR:8080)
WEB_BIND=127.0.0.1
# "sim" só para demonstração em http (localhost/IP). Em produção com https, deixe "nao".
AUTH_MODO_LOCAL=nao
# Atrás do nginx do compose, manter "sim"
TRUST_PROXY=sim
# Código da instituição fictícia (impresso pelo job instituicao). Esconde o campo no login.
INSTITUICAO_PADRAO_ID=
# Dados fictícios da instituição e do primeiro administrador
INSTITUICAO_NOME=Instituição Demonstração
ADMIN_NOME=Administrador Demonstração
ADMIN_EMAIL=admin@exemplo.invalid
